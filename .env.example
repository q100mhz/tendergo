# Домен и путь, по которым открывается сайт: https://itb2bhost.ru/tendergo
DOMAIN=itb2bhost.ru
# Путь начинается с косой черты и не заканчивается ею
BASE_PATH=/tendergo
# Локальный порт сервера, на который nginx проксирует /tendergo (снаружи он не виден)
WEB_PORT=8090

# Пароль БД и секрет подписи сессий. Сгенерируйте каждый командой: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Источник закупок: eis — zakupki.gov.ru, mock — тестовые данные
TENDER_SOURCE=eis
# Расписание загрузки (cron, московское время): каждый час в hh:05
INGEST_CRON=5 * * * *
INGEST_ON_START=true
# Пауза между запросами к ЕИС, мс
EIS_DELAY_MS=1500
# Сколько страниц выдачи (по 50 закупок, самые свежие обновления) просматривать за проход.
# Если в логах воркера появится «WARNING every card on the last page was new» — увеличьте.
EIS_MAX_PAGES=40
# Через сколько дней после окончания приёма заявок удалять закупки, которые никто не отметил
RETENTION_DAYS=30
